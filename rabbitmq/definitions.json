{
  "users": [
    {
      "name": "guest",
      "password": "guest",
      "tags": "administrator"
    },
    {
      "name": "wallet-ledger-service",
      "password": "wallet-ledger-service",
      "tags": ""
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "wallet-ledger-service",
      "vhost": "/",
      "configure": "^$",
      "write": "^wallet\\.event$",
      "read": "^wallet-event$"
    }
  ],
  "exchanges": [
    {
      "name": "wallet.event",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "wallet-event",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "wallet.event",
      "vhost": "/",
      "destination": "wallet-event",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ]
}
